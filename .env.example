# LLM provider: auto | anthropic | openai | ollama | offline
# "auto" picks Anthropic if ANTHROPIC_API_KEY is set, then OpenAI, else the offline rule engine.
LLM_PROVIDER=auto
# LLM_MODEL=claude-sonnet-5-5          # cheaper: claude-haiku-5-5 ; OpenAI default: gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DB_PATH=actiongraph.db
CHUNK_MAX_TOKENS=1500
CHUNK_OVERLAP_TURNS=2
REVIEW_CONFIDENCE_THRESHOLD=0.6
LOG_LEVEL=INFO
